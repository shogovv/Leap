{
  "manifest_version": 3,
  "name": "Leap",
  "version": "1.0.0",
  "description": "A keyboard-first new tab page. Search bookmarks, tabs, and closed tabs as you type, plus your own site-search shortcuts.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "bookmarks",
    "tabs",
    "sessions",
    "storage",
    "favicon",
    "search"
  ]
}
